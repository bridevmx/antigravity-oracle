# ==========================================
# Configuración de Antigravity Claude Proxy
# ==========================================
# Copia este archivo como .env y edita los valores en tu servidor o en las variables de Coolify.

# Puerto en el que escuchará el servidor interno (predeterminado: 3000)
PORT=3000

# Host de red para vincular la aplicación (0.0.0.0 para escuchar en todas las interfaces)
HOST=0.0.0.0

# Clave de API requerida para que los clientes (OpenCode, Claude Code CLI) accedan al proxy
# ¡REEMPLAZA este valor por una clave segura antes de desplegar!
API_KEY=your_secure_api_key_here

# Contraseña de acceso a la WebUI de administración de cuentas
# ¡REEMPLAZA este valor por una contraseña segura!
WEBUI_PASSWORD=your_secure_webui_password_here

# Entorno de ejecución (production o development)
NODE_ENV=production

# Permite redirigir a un proveedor alternativo en caso de cuota agotada (true / false)
FALLBACK=true

# Activa el modo de desarrollo y logs verbosos (true / false)
DEV_MODE=false

# Límite máximo de cuentas de Google registrabiles en el proxy
MAX_ACCOUNTS=10

# Umbral de cuota global (0.0 a 1.0) antes de marcar cuota en advertencia
GLOBAL_QUOTA_THRESHOLD=0.9
